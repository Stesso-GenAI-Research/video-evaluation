{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/action-semantics/preference-steps.schema.json",
  "title": "One project step for pairwise preference evaluation",
  "description": "Step text and resources used to build the fixed Project 1 Step 1 query.",
  "type": "object",
  "additionalProperties": true,
  "required": ["title", "description", "tools", "materials"],
  "anyOf": [
    {
      "required": ["id"]
    },
    {
      "required": ["step_id"]
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "step_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": ["string", "null"]
    },
    "description": {
      "type": ["string", "null"]
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
